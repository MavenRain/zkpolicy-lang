-- Sample domain. Replace it with your design. See domain/README.md.
-- Each family, constructor, field and def name here becomes a core name
-- (rule R4). Only this file can declare a family (rule R1).
family Color := red | green | blue
family Item := makeItem (itemColor : Color) (itemPrice : Nat) (itemCount : Nat)
family Stack := bottom | push (top : Nat) (rest : Stack)
-- A tree: a fold over a tree that exists at run time is a HOST-LIMIT.
family Tree := tip | fork (forkLeft : Tree) (forkRight : Tree)
-- An indexed family (former F15): `Lot 3` is a lot of size 3.
family Lot (size : Nat) := makeLot (lotPrice : Nat)

def lineTotal : (item : Item) -> Nat :=
  fun (item : Item) => natMul (itemPrice item) (itemCount item)
def isRed : (color : Color) -> Flag :=
  fun (color : Color) => fold flagYes flagNo flagNo color
def total : (items : List Item) -> Nat :=
  fun (items : List Item) => fold (fun (item : Item) (acc : Nat) => natAdd (lineTotal item) acc) 0 items
def redTotal : (items : List Item) -> Nat :=
  fun (items : List Item) => total (filter (fun (item : Item) => isRed (itemColor item)) items)
def depth : (s : Stack) -> Nat :=
  fun (s : Stack) => fold 0 (fun (top : Nat) (rest : Nat) => natAdd rest 1) s

-- The policy core (P6). See docs/PLAN.md sections 2 and 4, and
-- domain/README.md. An instance is a value of PolicyModel.

-- N10: the two visibilities of a field.
family Visibility := public | private

-- N9: Bool is the coproduct Unit + Unit. It is not a new base type.
def Bool : Type 0 := Sum Unit Unit
def true : Bool := inl unit
def false : Bool := inr unit

-- The context over the Field component: a public part and a private part.
def Ctx : (F : Visibility -> Type 0) -> Type 0 :=
  fun F => Prod (F public) (F private)
def pub : (F : Visibility -> Type 0) -> (c : Ctx F) -> F public :=
  fun F => fun c => first c
def priv : (F : Visibility -> Type 0) -> (c : Ctx F) -> F private :=
  fun F => fun c => second c

-- The signature (N1, N3). ZKProof takes the public part, not the context.
def PolicySig : Type 1 :=
  Sigma (Field : Visibility -> Type 0)
  (Sigma (Decision : Type 0)
  (Sigma (Policy : Type 0)
  (Sigma (Transcript : Type 0)
  (Sigma (ZKProof : Policy -> Field public -> Transcript -> Type 0)
  (Sigma (eval : Policy -> Ctx Field -> Decision)
  (Sigma (prove : (p : Policy) -> (c : Ctx Field) -> Sigma (t : Transcript) (ZKProof p (pub Field c) t))
  (Sigma (compose : Policy -> Policy -> Policy)
  (Sigma (restrict : Policy -> Policy)
  ((p : Policy) -> (x : Field public) -> (t : Transcript) -> ZKProof p x t -> Bool)))))))))
def Field : (S : PolicySig) -> Visibility -> Type 0 :=
  fun S => witness S
def Decision : (S : PolicySig) -> Type 0 :=
  fun S => witness (payload S)
def Policy : (S : PolicySig) -> Type 0 :=
  fun S => witness (payload (payload S))
def Transcript : (S : PolicySig) -> Type 0 :=
  fun S => witness (payload (payload (payload S)))
def ZKProof : (S : PolicySig) -> Policy S -> Field S public -> Transcript S -> Type 0 :=
  fun S => witness (payload (payload (payload (payload S))))
def eval : (S : PolicySig) -> Policy S -> Ctx (Field S) -> Decision S :=
  fun S => witness (payload (payload (payload (payload (payload S)))))
def prove : (S : PolicySig) -> (p : Policy S) -> (c : Ctx (Field S)) -> Sigma (t : Transcript S) (ZKProof S p (pub (Field S) c) t) :=
  fun S => witness (payload (payload (payload (payload (payload (payload S))))))
def compose : (S : PolicySig) -> Policy S -> Policy S -> Policy S :=
  fun S => witness (payload (payload (payload (payload (payload (payload (payload S)))))))
def restrict : (S : PolicySig) -> Policy S -> Policy S :=
  fun S => witness (payload (payload (payload (payload (payload (payload (payload (payload S))))))))
def verify : (S : PolicySig) -> (p : Policy S) -> (x : Field S public) -> (t : Transcript S) -> ZKProof S p x t -> Bool :=
  fun S => payload (payload (payload (payload (payload (payload (payload (payload (payload S))))))))

-- Two policies are equivalent when they give the same decision on each context.
def PolicyEquiv : (S : PolicySig) -> (p q : Policy S) -> Type 0 :=
  fun S => fun p => fun q => (c : Ctx (Field S)) -> Path (Decision S) (eval S p c) (eval S q c)

-- N9: equivalence of types from Pi, Sigma and Path only.
def isContr : (A : Type 0) -> Type 0 :=
  fun A => Sigma (x : A) ((y : A) -> Path A x y)
def fiber : (A B : Type 0) -> (f : A -> B) -> (y : B) -> Type 0 :=
  fun A => fun B => fun f => fun y => Sigma (x : A) (Path B (f x) y)
def isEquiv : (A B : Type 0) -> (f : A -> B) -> Type 0 :=
  fun A => fun B => fun f => (y : B) -> isContr (fiber A B f y)
def Equiv : (A B : Type 0) -> Type 0 :=
  fun A => fun B => Sigma (f : A -> B) (isEquiv A B f)

-- The laws. Each statement is one definition over the signature.
-- N2, O3: eval-compose gives the private part that q gets as a witness.
-- N4, O4: soundness as stated, and completeness. soundness-pub needs the
-- propositional truncation (C4), so it comes at P3.
def ComposeAssoc : (S : PolicySig) -> Type 0 :=
  fun S => (p q r : Policy S) -> Path (Policy S) (compose S (compose S p q) r) (compose S p (compose S q r))
def EvalCompose : (S : PolicySig) -> Type 0 :=
  fun S => (p q : Policy S) -> (c : Ctx (Field S)) -> Sigma (x : Field S private) (Path (Decision S) (eval S (compose S p q) c) (eval S q (pair (pub (Field S) c) x)))
def Soundness : (S : PolicySig) -> Type 0 :=
  fun S => (p : Policy S) -> (c : Ctx (Field S)) -> Path (Decision S) (eval S p c) (eval S p c)
def Privacy : (S : PolicySig) -> Type 0 :=
  fun S => (p : Policy S) -> (c1 c2 : Ctx (Field S)) -> Path (Field S public) (pub (Field S) c1) (pub (Field S) c2) -> Path (Decision S) (eval S (restrict S p) c1) (eval S (restrict S p) c2)
def Completeness : (S : PolicySig) -> Type 0 :=
  fun S => (p : Policy S) -> (c : Ctx (Field S)) -> Path Bool (verify S p (pub (Field S) c) (witness (prove S p c)) (payload (prove S p c))) true
def SipPolicy : (S : PolicySig) -> Type 0 :=
  fun S => (p q : Policy S) -> Equiv (PolicyEquiv S p q) (Path (Policy S) p q)
def PolicyLaws : (S : PolicySig) -> Type 0 :=
  fun S => Sigma (composeAssoc : ComposeAssoc S)
  (Sigma (evalCompose : EvalCompose S)
  (Sigma (soundness : Soundness S)
  (Sigma (privacy : Privacy S)
  (Sigma (completeness : Completeness S)
  (SipPolicy S)))))

-- A model: a signature and a proof of each law.
def PolicyModel : Type 1 := Sigma (S : PolicySig) (PolicyLaws S)
def sig : (M : PolicyModel) -> PolicySig :=
  fun M => witness M
def laws : (M : PolicyModel) -> PolicyLaws (sig M) :=
  fun M => payload M
def composeAssoc : (M : PolicyModel) -> ComposeAssoc (sig M) :=
  fun M => witness (laws M)
def evalCompose : (M : PolicyModel) -> EvalCompose (sig M) :=
  fun M => witness (payload (laws M))
def soundness : (M : PolicyModel) -> Soundness (sig M) :=
  fun M => witness (payload (payload (laws M)))
def privacy : (M : PolicyModel) -> Privacy (sig M) :=
  fun M => witness (payload (payload (payload (laws M))))
def completeness : (M : PolicyModel) -> Completeness (sig M) :=
  fun M => witness (payload (payload (payload (payload (laws M)))))
def sipPolicy : (M : PolicyModel) -> SipPolicy (sig M) :=
  fun M => payload (payload (payload (payload (payload (laws M)))))

-- Lemmas over each model. pequivTrans uses path composition (trans, C3).
def pequivRefl : (M : PolicyModel) -> (p : Policy (sig M)) -> PolicyEquiv (sig M) p p :=
  fun M => fun p => fun c => refl
def pequivSymm : (M : PolicyModel) -> (p q : Policy (sig M)) -> PolicyEquiv (sig M) p q -> PolicyEquiv (sig M) q p :=
  fun M => fun p => fun q => fun h => fun c => symm (h c)
def pequivTrans : (M : PolicyModel) -> (p q r : Policy (sig M)) -> PolicyEquiv (sig M) p q -> PolicyEquiv (sig M) q r -> PolicyEquiv (sig M) p r :=
  fun M => fun p => fun q => fun r => fun h => fun k => fun c => trans (h c) (k c)
def privacySamePub : (M : PolicyModel) -> (p : Policy (sig M)) -> (x : Field (sig M) public) -> (y1 y2 : Field (sig M) private) -> Path (Decision (sig M)) (eval (sig M) (restrict (sig M) p) (pair x y1)) (eval (sig M) (restrict (sig M) p) (pair x y2)) :=
  fun M => fun p => fun x => fun y1 => fun y2 => privacy M p (pair x y1) (pair x y2) refl

-- The Ref instance (P7a). See docs/PLAN.md sections 2 and 5. Both parts
-- of a context are numbers. A layer changes the private part, and the
-- public part stays. The decision is the resulting private part; isZero
-- tests acceptance. Retaining the state lets compose and prove respect
-- PolicyEquiv when Policy becomes a quotient in P7b.
family Layer := sealPrivate | addPublic | subPublic | addConst (constAmount : Nat)

def refField : (v : Visibility) -> Type 0 :=
  fun (v : Visibility) => fold Nat Nat v
-- Nat is bounded by the host. Saturating addition keeps every layer total
-- without evaluating an overflowing natAdd, including during verification.
def refAdd : (x y : Nat) -> Nat :=
  fun (x y : Nat) => natSub 18446744073709551615 (natSub (natSub 18446744073709551615 x) y)
def layerStep : (l : Layer) -> (x : Nat) -> (y : Nat) -> Nat :=
  fun (l : Layer) => fun (x : Nat) => fun (y : Nat) => fold 0 (refAdd x y) (natSub y x) (fun (k : Nat) => refAdd k y) l
-- The layers apply from the head of the list to its end.
def refRun : (p : List Layer) -> (x : Nat) -> Nat -> Nat :=
  fun (p : List Layer) => fun (x : Nat) => fold (fun (l : Layer) (k : Nat -> Nat) => fun (y : Nat) => k (layerStep l x y)) (fun (y : Nat) => y) p
def isZero : (n : Nat) -> Bool :=
  fun (n : Nat) => fold (fun (b : Bool) => false) true n
def flagBool : (f : Flag) -> Bool :=
  fun (f : Flag) => flagIf f true false
def refEval : (p : List Layer) -> (c : Ctx refField) -> Nat :=
  fun (p : List Layer) => fun (c : Ctx refField) => refRun p (pub refField c) (priv refField c)
-- N4: the certificate is the private part. It is data, and it holds no path.
def refProof : (p : List Layer) -> (x : Nat) -> (t : Nat) -> Type 0 :=
  fun (p : List Layer) => fun (x : Nat) => fun (t : Nat) => Nat
def refProve : (p : List Layer) -> (c : Ctx refField) -> Sigma (t : Nat) Nat :=
  fun (p : List Layer) => fun (c : Ctx refField) => pack (refRun p (pub refField c) (priv refField c)) (priv refField c)
-- N6: compose is append.
def refCompose : (p q : List Layer) -> List Layer :=
  fun (p : List Layer) => fun (q : List Layer) => fold (fun (l : Layer) (acc : List Layer) => cons l acc) q p
-- restrict p runs p on the public part and a private part of 0.
def refRestrict : (p : List Layer) -> List Layer :=
  fun (p : List Layer) => cons sealPrivate p
-- verify compares the transcript with a decidable equality on Nat.
def refVerify : (p : List Layer) -> (x : Nat) -> (t : Nat) -> (y : Nat) -> Bool :=
  fun (p : List Layer) => fun (x : Nat) => fun (t : Nat) => fun (y : Nat) => flagBool (natEq (refRun p x y) t)
def refSig : PolicySig :=
  pack refField (pack Nat (pack (List Layer) (pack Nat (pack refProof (pack refEval (pack refProve (pack refCompose (pack refRestrict refVerify))))))))

-- The laws that P7a proves. ComposeAssoc, EvalCompose and Completeness
-- need induction on List and Nat (C4), so they come at P7b with
-- SipPolicy.
def refSoundness : Soundness refSig :=
  fun p => fun c => refl
def refPrivacy : Privacy refSig :=
  fun p => fun c1 => fun c2 => fun h => cong (fun (x : Nat) => refRun p x 0) h
