  fun x => quotRec GPolicy (PolicyEquiv gSig) (GQ -> GQ) (fun (p : GPolicy) => gqComposeR p) gqComposeGlue isSetGQFun x
-- The laws that need no induction over the block (ruling R8). Soundness
-- holds by refl. Privacy uses the path between the public policies:
-- eval (restrict p) c is govDec (gov (pub gField c) (gRun p 0)).
-- Completeness is natEqRefl. SoundnessPub is
-- truncIn with natEqSound.
def gSoundness : Soundness gSig :=
  fun (p : GPolicy) (c : Ctx gField) => refl
def gPrivacy : Privacy gSig :=
  fun (p : GPolicy) (c1 : Ctx gField) (c2 : Ctx gField) (h : Path GPolicy (pub gField c1) (pub gField c2)) => cong (fun (x : GPolicy) => govDec (gov x (gRun p 0))) h
def gCompleteness : Completeness gSig :=
  fun (p : GPolicy) (c : Ctx gField) => cong flagBool (natEqRefl (govDec (gov (pub gField c) (gRun p (priv gField c)))))
def gSoundnessPub : SoundnessPub gSig :=
  fun (p : GPolicy) (x : GPolicy) (t : Nat) (pi : Nat) (h : Path Bool (gVerify p x t pi) true) => truncIn (Sigma (y : Nat) (Path Nat (govDec (gov x (gRun p y))) t)) (pack pi (natEqSound (govDec (gov x (gRun p pi))) t h))

-- The quotient sig (P11b), as refQSig. A policy is a GPolicy up to
-- PolicyEquiv gSig. prove, restrict and verify go through gqEval.
-- restrict respects PolicyEquiv at the context with the private part 0,
-- because gSeal runs to 0.
def gqProof : GQ -> GPolicy -> Nat -> Type 0 :=
  fun z x t => Nat
def gqProve : (z : GQ) -> (c : Ctx gField) -> Sigma (t : Nat) (gqProof z (pub gField c) t) :=
  fun z c => pack (gqEval z c) (priv gField c)
def gqRespRestrict : (p q : GPolicy) -> PolicyEquiv gSig p q -> PolicyEquiv gSig (gRestrict p) (gRestrict q) :=
  fun p q h c => h (pair (pub gField c) 0)
