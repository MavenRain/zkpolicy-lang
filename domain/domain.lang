  fun p1 p2 h => <i> fun (y : GQ) => fold (fun (w : GQ) => Path GQ (gqComposeR p1 w) (gqComposeR p2 w)) (fun (w : GQ) => isSetQuot GPolicy (PolicyEquiv gSig) (gqComposeR p1 w) (gqComposeR p2 w)) (fun (q : GPolicy) => quotGlue GPolicy (PolicyEquiv gSig) (gCompose p1 q) (gCompose p2 q) (gqRespL p1 p2 q h)) y @ i
