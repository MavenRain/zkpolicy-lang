  fun p q z => fold (fun (w : GQ) => Path GQ (gqComposeR (gCompose p q) w) (gqComposeR p (gqComposeR q w))) (fun (w : GQ) => isSetQuot GPolicy (PolicyEquiv gSig) (gqComposeR (gCompose p q) w) (gqComposeR p (gqComposeR q w))) (fun (r : GPolicy) => cong (fun (u : GPolicy) => gqin u) (gComposeAssoc p q r)) z
def gqComposeAssoc : ComposeAssoc gQSig :=
  fun x y z => fold (fun (u : GQ) => Path GQ (gqCompose (gqCompose u y) z) (gqCompose u (gqCompose y z))) (fun (u : GQ) => isSetQuot GPolicy (PolicyEquiv gSig) (gqCompose (gqCompose u y) z) (gqCompose u (gqCompose y z))) (fun (p : GPolicy) => fold (fun (v : GQ) => Path GQ (gqCompose (gqComposeR p v) z) (gqComposeR p (gqCompose v z))) (fun (v : GQ) => isSetQuot GPolicy (PolicyEquiv gSig) (gqCompose (gqComposeR p v) z) (gqComposeR p (gqCompose v z))) (fun (q : GPolicy) => gqAssocR p q z) y) x
-- The witness is the decision of x at the public part gpNil. This is the
-- private value after x, because govDec (gov gpNil w) is w.
def gqEvalCompose : EvalCompose gQSig :=
  fun x y c => pack (gqEval x (pair gpNil (priv gField c))) (fold (fun (u : GQ) => Path Nat (gqEval (gqCompose u y) c) (gqEval y (pair (pub gField c) (gqEval u (pair gpNil (priv gField c)))))) (fun (u : GQ) => natIsSet (gqEval (gqCompose u y) c) (gqEval y (pair (pub gField c) (gqEval u (pair gpNil (priv gField c)))))) (fun (p : GPolicy) => fold (fun (v : GQ) => Path Nat (gqEval (gqComposeR p v) c) (gqEval v (pair (pub gField c) (gRun p (priv gField c))))) (fun (v : GQ) => natIsSet (gqEval (gqComposeR p v) c) (gqEval v (pair (pub gField c) (gRun p (priv gField c))))) (fun (q : GPolicy) => cong (fun (w : Nat) => govDec (gov (pub gField c) w)) (gRunCompose p q (priv gField c))) y) x)
def gqPrivacy : Privacy gQSig :=
  fun z c1 c2 h => fold (fun (u : GQ) => Path Nat (gqEval (gqRestrict u) c1) (gqEval (gqRestrict u) c2)) (fun (u : GQ) => natIsSet (gqEval (gqRestrict u) c1) (gqEval (gqRestrict u) c2)) (fun (p : GPolicy) => gPrivacy p c1 c2 h) z
-- Sip on the quotient. GQEquiv is the body of PolicyEquiv gQSig, so gqSip
-- is SipPolicy gQSig. GQEquiv is a proposition, because Nat is a set.
def GQEquiv : (z w : GQ) -> Type 0 :=
  fun z w => (c : Ctx gField) -> Path Nat (gqEval z c) (gqEval w c)
def gqPequivProp : (z w : GQ) -> isProp (GQEquiv z w) :=
  fun z w h k => <i> fun (c : Ctx gField) => natIsSet (gqEval z c) (gqEval w c) (h c) (k c) @ i
-- From GQEquiv to a path: a fold over each policy. The motive is a
-- function type into paths of GQ, a proposition by isSetQuot. At gqin p
-- and gqin q, the path is the glue constructor.
def gqTo : (z w : GQ) -> GQEquiv z w -> Path GQ z w :=
  fun z => fold (fun (u : GQ) => (w : GQ) -> GQEquiv u w -> Path GQ u w) (fun (u : GQ) (f : (w : GQ) -> GQEquiv u w -> Path GQ u w) (g : (w : GQ) -> GQEquiv u w -> Path GQ u w) => <i> fun (w : GQ) (e : GQEquiv u w) => isSetQuot GPolicy (PolicyEquiv gSig) u w (f w e) (g w e) @ i) (fun (p : GPolicy) (w : GQ) => fold (fun (v : GQ) => GQEquiv (gqin p) v -> Path GQ (gqin p) v) (fun (v : GQ) (f : GQEquiv (gqin p) v -> Path GQ (gqin p) v) (g : GQEquiv (gqin p) v -> Path GQ (gqin p) v) => <i> fun (e : GQEquiv (gqin p) v) => isSetQuot GPolicy (PolicyEquiv gSig) (gqin p) v (f e) (g e) @ i) (fun (q : GPolicy) (e : GQEquiv (gqin p) (gqin q)) => quotGlue GPolicy (PolicyEquiv gSig) p q e) w) z
def gqSip : SipPolicy gQSig :=
  fun z w => propEquiv (GQEquiv z w) (Path GQ z w) (gqPequivProp z w) (isSetQuot GPolicy (PolicyEquiv gSig) z w) (gqTo z w) (fun e c => cong (fun (u : GQ) => gqEval u c) e)
-- The quotient sig gQSig has the 7 laws, so it is a model.
def govModel : PolicyModel :=
  pack gQSig (pack gqComposeAssoc (pack gqEvalCompose (pack gqSoundness (pack gqSoundnessPub (pack gqPrivacy (pack gqCompleteness gqSip))))))

-- ZkmlCircuit (P9a, rule R2): the zkml-lang circuit interface at zkml-lang 7d0bb2d.
-- ZLayer is the zkml-lang family Layer. The Ref layer has the name Layer (rule R4).
family Resource := res (resGates resLookups resDegree : Nat)
def zeroR : Resource := res 0 0 0
def resAdd : (r : Resource) -> (s : Resource) -> Resource :=
  fun (r : Resource) (s : Resource) => res (natAdd (resGates r) (resGates s)) (natAdd (resLookups r) (resLookups s)) (natMax (resDegree r) (resDegree s))
def Tensor : Type 0 -> Shape -> Type 0 :=
  fun (A : Type 0) (s : Shape) => fold (fun (d : Nat) (T : Type 0) => List T) A (dims s)
family Inst := mkInst (instF : Type 0) (instWitness : Type 0) (instWeights : Type 0)
  (instWeightsOf : instWitness -> instWeights)
  (instSat : (a b : Shape) -> Circuit a b -> Tensor instF a -> instWitness -> Type 0)
  (instEval : (a b : Shape) -> Circuit a b -> instWitness -> Tensor instF b)
  (instInputWit : (s : Shape) -> instWeights -> Tensor instF s -> instWitness)
  (instInputWeights : (s : Shape) -> (ws : instWeights) -> (x : Tensor instF s) -> Path instWeights (instWeightsOf (instInputWit s ws x)) ws)
  (instInputSat : (s : Shape) -> (ws : instWeights) -> (x : Tensor instF s) -> instSat s s (circId s) x (instInputWit s ws x))
  (instInputEval : (s : Shape) -> (ws : instWeights) -> (x : Tensor instF s) -> Path (Tensor instF s) (instEval s s (circId s) (instInputWit s ws x)) x)
  (instIdSound : (s : Shape) -> (x : Tensor instF s) -> (w : instWitness) -> instSat s s (circId s) x w -> Path (Tensor instF s) x (instEval s s (circId s) w))
  (instSeqWit : (a b c : Shape) -> (f : Circuit a b) -> (g : Circuit b c) -> instWitness -> instWitness -> instWitness)
  (instSeqSat : (a b c : Shape) -> (f : Circuit a b) -> (g : Circuit b c) -> (x : Tensor instF a) -> (w : instWitness) -> instSat a c (circSeq a b c f g) x w -> Trunc (Sigma (u : instWitness) (Sigma (v : instWitness) (Prod (Path instWitness w (instSeqWit a b c f g u v)) (Prod (Path instWeights (instWeightsOf u) (instWeightsOf v)) (Prod (instSat a b f x u) (instSat b c g (instEval a b f u) v)))))))
  (instSeqWitWeights : (a b c : Shape) -> (f : Circuit a b) -> (g : Circuit b c) -> (u v : instWitness) -> Path instWeights (instWeightsOf u) (instWeightsOf v) -> Path instWeights (instWeightsOf (instSeqWit a b c f g u v)) (instWeightsOf u))
  (instSeqWitSat : (a b c : Shape) -> (f : Circuit a b) -> (g : Circuit b c) -> (x : Tensor instF a) -> (u v : instWitness) -> Path instWeights (instWeightsOf u) (instWeightsOf v) -> instSat a b f x u -> instSat b c g (instEval a b f u) v -> instSat a c (circSeq a b c f g) x (instSeqWit a b c f g u v))
  (instSeqWitEval : (a b c : Shape) -> (f : Circuit a b) -> (g : Circuit b c) -> (u v : instWitness) -> Path (Tensor instF c) (instEval a c (circSeq a b c f g) (instSeqWit a b c f g u v)) (instEval b c g v))
  (instTensorSet : (s : Shape) -> isSet (Tensor instF s))
def layerWit : (I : Inst) -> (a b : Shape) -> (f : Circuit a b) -> (den : instWeights I -> Tensor (instF I) a -> Tensor (instF I) b) -> (ws : instWeights I) -> (x : Tensor (instF I) a) -> Type 0 :=
  fun I a b f den ws x => Sigma (w : instWitness I) (Prod (Path (instWeights I) (instWeightsOf I w) ws) (Prod (instSat I a b f x w) (Path (Tensor (instF I) b) (den ws x) (instEval I a b f w))))
family ZLayer (I : Inst) (inS outS : Shape) := zlayer (layerCircuit : Circuit inS outS)
  (layerDen : instWeights I -> Tensor (instF I) inS -> Tensor (instF I) outS)
  (layerSound : (x : Tensor (instF I) inS) -> (w : instWitness I) -> instSat I inS outS layerCircuit x w -> Path (Tensor (instF I) outS) (layerDen (instWeightsOf I w) x) (instEval I inS outS layerCircuit w))
  (layerComplete : (ws : instWeights I) -> (x : Tensor (instF I) inS) -> Trunc (layerWit I inS outS layerCircuit layerDen ws x))
  (layerRes : Resource)
-- The identity layer: the circuit circId, the identity denotation and zero resources.
def zIdL : (I : Inst) -> (s : Shape) -> ZLayer I s s :=
  fun I s => zlayer I s s (circId s) (fun (ws : instWeights I) (x : Tensor (instF I) s) => x)
    (fun (x : Tensor (instF I) s) (w : instWitness I) (h : instSat I s s (circId s) x w) => instIdSound I s x w h)
    (fun (ws : instWeights I) (x : Tensor (instF I) s) => truncIn (layerWit I s s (circId s) (fun (vs : instWeights I) (y : Tensor (instF I) s) => y) ws x) (pack (instInputWit I s ws x) (pair (instInputWeights I s ws x) (pair (instInputSat I s ws x) (symm (instInputEval I s ws x))))))
    zeroR
-- BabyBear (Z6d): p = 2^31 - 2^27 + 1. A field value is a Nat below p. The
-- product of two values is below 2^62, so natMul does not trap. bbSub
-- reduces b first, so a + p - b does not truncate at 0.
def bbP : Nat := 2013265921
def bbAdd : Nat -> Nat -> Nat := fun a b => natMod (natAdd a b) bbP
def bbSub : Nat -> Nat -> Nat := fun a b => natMod (natSub (natAdd a bbP) (natMod b bbP)) bbP
def bbMul : Nat -> Nat -> Nat := fun a b => natMod (natMul a b) bbP
def bbNeg : Nat -> Nat := fun a => bbSub 0 a
-- listUncons: the head and tail of a nonempty list.
def listUncons : (A : Type 0) -> List A -> Option (Prod A (List A)) :=
  fun A xs => fold (fun (l : List A) => Option (Prod A (List A))) (fun (x : A) => fun (t : List A) => fun (r : Option (Prod A (List A))) => some (pair x t)) none xs
-- listZipWith: unfold the two tails, bounded by the length of xs. The state
-- contains list data, so a runtime list does not require a function value.
-- It stops at the end of the shorter list.
def listZipWith : (A B C : Type 0) -> (A -> B -> C) -> List A -> List B -> List C :=
  fun A B C f xs ys => unfold
    (fun (st : Prod (List A) (List B)) => bind (listUncons A (first st)) (fun (a : Prod A (List A)) => map (fun (b : Prod B (List B)) => pair (f (first a) (first b)) (pair (second a) (second b))) (listUncons B (second st))))
    (fold (fun (x : A) (n : Nat) => natAdd n 1) 0 xs) (pair xs ys)
