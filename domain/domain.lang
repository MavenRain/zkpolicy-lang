  fun z x t y => flagBool (natEq (gqEval z (pair x y)) t)
def gQSig : PolicySig :=
  pack gField (pack Nat (pack GQ (pack Nat (pack gqProof (pack gqEval (pack gqProve (pack gqCompose (pack gqRestrict gqVerify))))))))
-- The laws on gQSig. Soundness, Completeness and SoundnessPub need no
-- fold. Each other law is a fold over each policy, from the gSig law at
-- gqin p. The motive is a path type in GQ (a set by isSetQuot) or in Nat.
def gqSoundness : Soundness gQSig :=
  fun z c => refl
def gqCompleteness : Completeness gQSig :=
  fun z c => cong flagBool (natEqRefl (gqEval z c))
def gqSoundnessPub : SoundnessPub gQSig :=
  fun z x t pi h => truncIn (Sigma (y : Nat) (Path Nat (gqEval z (pair x y)) t)) (pack pi (natEqSound (gqEval z (pair x pi)) t h))
