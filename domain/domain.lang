def gEvalCompose : EvalCompose gSig :=
  fun (p q : GPolicy) (c : Ctx gField) => pack (gRun p (priv gField c)) (cong (fun (w : Nat) => govDec (gov (pub gField c) w)) (gRunCompose p q (priv gField c)))
-- gqCompose on GQ, as qCompose on QPolicy. compose respects PolicyEquiv
-- gSig on the right and on the left. The left proof uses the context
