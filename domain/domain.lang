  fun z => quotRec GPolicy (PolicyEquiv gSig) GQ (fun (p : GPolicy) => gqin (gRestrict p)) (fun (p : GPolicy) (q : GPolicy) (h : PolicyEquiv gSig p q) => quotGlue GPolicy (PolicyEquiv gSig) (gRestrict p) (gRestrict q) (gqRespRestrict p q h)) (isSetQuot GPolicy (PolicyEquiv gSig)) z
