def gqRespR : (p q1 q2 : GPolicy) -> PolicyEquiv gSig q1 q2 -> PolicyEquiv gSig (gCompose p q1) (gCompose p q2) :=
  fun p q1 q2 h c => trans (cong (fun (w : Nat) => govDec (gov (pub gField c) w)) (gRunCompose p q1 (priv gField c))) (trans (h (pair (pub gField c) (gRun p (priv gField c)))) (symm (cong (fun (w : Nat) => govDec (gov (pub gField c) w)) (gRunCompose p q2 (priv gField c)))))
