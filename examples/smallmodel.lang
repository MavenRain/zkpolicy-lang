-- SmallModel (P9a, rule R3): a dense 2x2 policy over the BabyBear field.
-- The weights are a List (List Nat): Tensor Nat (shape (cons 2 (cons 2 nil))) by the fold.
-- SMDecision is the Tensor Nat of the output shape. SMPolicy is the quotient of the
-- weights by equal denotation.
def smOut : Shape := shape (cons 2 nil)
def SMDecision : Type 0 := Tensor Nat smOut
def smW : List (List Nat) := cons (cons 1 (cons 2 nil)) (cons (cons 3 (cons 4 nil)) nil)
-- smDot: the dot product of a row and the input, in the field.
def smDot : List Nat -> List Nat -> Nat := fun (r : List Nat) (x : List Nat) => fold (fun (v : Nat) (acc : Nat) => bbAdd acc v) 0 (listZipWith Nat Nat Nat bbMul r x)
-- smDense: one dot product for each row of the weights.
def smDense : List (List Nat) -> List Nat -> SMDecision := fun (w : List (List Nat)) (x : List Nat) => fold (fun (r : List Nat) (acc : List Nat) => cons (smDot r x) acc) nil w
-- smRes: the residual layer x + smDense w x, in the field.
def smRes : List (List Nat) -> List Nat -> SMDecision := fun (w : List (List Nat)) (x : List Nat) => listZipWith Nat Nat Nat bbAdd x (smDense w x)
-- smEnc: y1 * 1000 + y0, a Nat code of a decision for the eval rows.
def smEnc : List Nat -> Nat := fun (ys : List Nat) => fold (fun (v : Nat) (acc : Nat) => natAdd (natMul acc 1000) v) 0 ys
def smDenseE : Nat -> Nat -> Nat := fun a b => smEnc (smDense smW (cons a (cons b nil)))
def smResE : Nat -> Nat -> Nat := fun a b => smEnc (smRes smW (cons a (cons b nil)))
-- smResLoop: n residual layers of the weights w, by Nat induction.
def smResLoop : Nat -> List (List Nat) -> List Nat -> SMDecision := fun (n : Nat) (w : List (List Nat)) (x : List Nat) => fold (fun (k : Nat) => SMDecision) (fun (k : Nat) (acc : SMDecision) => smRes w acc) x n
def smRes2E : Nat -> Nat -> Nat := fun a b => smEnc (smResLoop 2 smW (cons a (cons b nil)))
-- smSq: the activation table, rows [k, k * k] for k = 0 to 9. A key not in the table reads as the default (0 in smAct), as bbLookup at the PIN.
def smSq : List (List Nat) := cons (cons 0 (cons 0 nil)) (cons (cons 1 (cons 1 nil)) (cons (cons 2 (cons 4 nil)) (cons (cons 3 (cons 9 nil)) (cons (cons 4 (cons 16 nil)) (cons (cons 5 (cons 25 nil)) (cons (cons 6 (cons 36 nil)) (cons (cons 7 (cons 49 nil)) (cons (cons 8 (cons 64 nil)) (cons (cons 9 (cons 81 nil)) nil)))))))))
-- smTableRow and smLookup: the pin's bbTableRow and bbLookup, copied under sm names (the host domain has no bbLookup).
def smTableRow : List Nat -> Option (Prod Nat Nat) := fun (r : List Nat) => fold (fun (l : List Nat) => Option (Prod Nat Nat)) (fun (h : Nat) => fun (t : List Nat) => fun (ih : Option (Prod Nat Nat)) => fold (fun (e : Nat) (acc : Option (Prod Nat Nat)) => some (pair h e)) none t) none r
def smLookup : List (List Nat) -> Nat -> Nat -> Nat := fun (tb : List (List Nat)) (d : Nat) (v : Nat) => fold (fun (r : List Nat) (acc : Nat) => option acc (fun (kv : Prod Nat Nat) => flagIf (natEq (first kv) v) (second kv) acc) (smTableRow r)) d tb
-- smAct: the dense layer, then the table lookup on each entry.
def smAct : List (List Nat) -> List (List Nat) -> List Nat -> SMDecision := fun (tb : List (List Nat)) (w : List (List Nat)) (x : List Nat) => map (fun (v : Nat) => smLookup tb 0 v) (smDense w x)
def smActE : Nat -> Nat -> Nat := fun a b => smEnc (smAct smSq smW (cons a (cons b nil)))
-- SMPolicy: the weights, up to equal denotation. smEvalAt reads a policy through quotRec.
def smRel : List (List Nat) -> List (List Nat) -> Type 0 := fun (w : List (List Nat)) (v : List (List Nat)) => Path (List Nat -> SMDecision) (smDense w) (smDense v)
def SMPolicy : Type 0 := Quot (List (List Nat)) smRel
def smEvalAt : SMPolicy -> Nat -> Nat -> Nat := fun (p : SMPolicy) (a : Nat) (b : Nat) => quotRec (List (List Nat)) smRel Nat (fun (w : List (List Nat)) => smEnc (smDense w (cons a (cons b nil)))) (fun (w : List (List Nat)) (v : List (List Nat)) (r : smRel w v) => <i> smEnc ((r @ i) (cons a (cons b nil)))) natIsSet p
def smPolicyE : Nat -> Nat -> Nat := fun a b => smEvalAt (quotIn (List (List Nat)) smRel smW) a b
-- The BabyBear operations of the domain, for the eval rows.
def bbAddOf : Nat -> Nat -> Nat := fun a b => bbAdd a b
def bbSubOf : Nat -> Nat -> Nat := fun a b => bbSub a b
def bbMulOf : Nat -> Nat -> Nat := fun a b => bbMul a b
def bbNegOf : Nat -> Nat := fun a => bbNeg a
def smSumNat : List Nat -> Nat := fun xs => fold (fun (h : Nat) (acc : Nat) => natAdd h acc) 0 xs
def smMaxNat : List Nat -> Nat := fun xs => fold (fun (h : Nat) (acc : Nat) => natMax h acc) 0 xs
def smSoftDouble : Nat -> Prod Nat Nat -> Prod Nat Nat := fun t qr => pair (natAdd (natMul 2 (first qr)) (flagIf (natLe (natSub t (second qr)) (second qr)) 1 0)) (natAdd (natSub (second qr) (natSub t (second qr))) (natMul 2 (flagIf (natLe (natSub t (second qr)) (second qr)) 0 (second qr))))
-- natMod v 1 keeps the step count dynamic when v is open, so lowering shares the quotient and remainder in a loop.
def smSoftScale : Nat -> Nat -> Nat -> Nat := fun k t v => first (fold (fun (n : Nat) => Prod Nat Nat) (fun (n : Nat) (qr : Prod Nat Nat) => smSoftDouble t qr) (pair (natDiv v t) (natMod v t)) (natAdd k (natMod v 1)))
def smSoftDiv : Nat -> Nat -> List Nat -> List Nat := fun k t e => map (fun (v : Nat) => smSoftScale k (natMax t 1) v) e
def smSoftExp : List (List Nat) -> Nat -> List Nat -> List Nat := fun tb m x => map (fun (v : Nat) => smLookup tb 0 (natSub m v)) x
def smSoftNorm : Nat -> List Nat -> List Nat := fun k e => smSoftDiv k (smSumNat e) e
def smSoftRow : List (List Nat) -> Nat -> List Nat -> List Nat := fun tb k x => smSoftNorm k (smSoftExp tb (smMaxNat x) x)
def smExp : List (List Nat) := cons (cons 0 (cons 256 nil)) (cons (cons 1 (cons 94 nil)) (cons (cons 2 (cons 35 nil)) (cons (cons 3 (cons 13 nil)) (cons (cons 4 (cons 5 nil)) (cons (cons 5 (cons 2 nil)) (cons (cons 6 (cons 1 nil)) nil))))))
def smSoft : List (List Nat) -> List (List Nat) -> List Nat -> SMDecision := fun (tb : List (List Nat)) (w : List (List Nat)) (x : List Nat) => smSoftRow tb 3 (smDense w x)
def smSoftE : Nat -> Nat -> Nat := fun a b => smEnc (smSoft smExp smW (cons a (cons b nil)))
def smLen : List Nat -> Nat := fun xs => fold (fun (h : Nat) (acc : Nat) => natAdd 1 acc) 0 xs
def smGamma : List (List Nat) -> List Nat := fun gb => fold (fun (h : List Nat) (acc : List Nat) => h) nil gb
def smBeta : List (List Nat) -> List Nat := fun gb => fold (fun (l : List (List Nat)) => List Nat) (fun (h : List Nat) => fun (t : List (List Nat)) => fun (ih : List Nat) => smGamma t) nil gb
def smLnMean : List Nat -> Nat := fun x => natDiv (smSumNat x) (natMax (smLen x) 1)
def smLnCenter : Nat -> List Nat -> List Nat := fun mu x => map (fun (v : Nat) => bbSub v mu) x
def smLnVar : List Nat -> Nat := fun c => natDiv (fold (fun (h : Nat) (acc : Nat) => bbAdd (bbMul h h) acc) 0 c) (natMax (smLen c) 1)
def smLnAffine : List (List Nat) -> Nat -> List Nat -> List Nat := fun gb r c => listZipWith Nat Nat Nat bbAdd (listZipWith Nat Nat Nat bbMul (map (fun (v : Nat) => bbMul v r) c) (smGamma gb)) (smBeta gb)
def smLnScaled : List (List Nat) -> List (List Nat) -> List Nat -> List Nat := fun gb tb c => smLnAffine gb (fold (fun (n : Nat) => Nat) (fun (n : Nat) (acc : Nat) => smLookup tb 0 acc) (smLnVar c) (natAdd 1 (natMod (smLnVar c) 1))) c
def smLnRow : List (List Nat) -> List (List Nat) -> List Nat -> List Nat := fun gb tb x => smLnScaled gb tb (smLnCenter (smLnMean x) x)
def smGB : List (List Nat) := cons (cons 2 (cons 3 nil)) (cons (cons 5 (cons 7 nil)) nil)
def smIsq : List (List Nat) := cons (cons 0 (cons 256 nil)) (cons (cons 1 (cons 256 nil)) (cons (cons 2 (cons 181 nil)) (cons (cons 3 (cons 147 nil)) (cons (cons 4 (cons 128 nil)) (cons (cons 5 (cons 114 nil)) (cons (cons 6 (cons 104 nil)) (cons (cons 7 (cons 96 nil)) (cons (cons 8 (cons 90 nil)) (cons (cons 9 (cons 85 nil)) (cons (cons 10 (cons 80 nil)) (cons (cons 11 (cons 77 nil)) (cons (cons 12 (cons 73 nil)) (cons (cons 13 (cons 71 nil)) (cons (cons 14 (cons 68 nil)) (cons (cons 15 (cons 66 nil)) (cons (cons 16 (cons 64 nil)) (cons (cons 17 (cons 62 nil)) (cons (cons 18 (cons 60 nil)) (cons (cons 19 (cons 58 nil)) (cons (cons 20 (cons 57 nil)) (cons (cons 21 (cons 55 nil)) (cons (cons 22 (cons 54 nil)) (cons (cons 23 (cons 53 nil)) (cons (cons 24 (cons 52 nil)) (cons (cons 25 (cons 51 nil)) nil)))))))))))))))))))))))))
def smLn : List (List Nat) -> List (List Nat) -> List (List Nat) -> List Nat -> SMDecision := fun (gb : List (List Nat)) (tb : List (List Nat)) (w : List (List Nat)) (x : List Nat) => smLnRow gb tb (smDense w x)
def smLnE : Nat -> Nat -> Nat := fun a b => smEnc (smLn smGB smIsq smW (cons a (cons b nil)))
