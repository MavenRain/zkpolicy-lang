-- Former C1 (faces, partial elements and systems). A system covers its
-- declared face, its branches agree where two faces meet, and fromPartial
-- reads a system at a face that holds.

def s : (i : I) -> Partial (~ i \/ i) Nat := fun i => [ (i = 0) |-> 0 , (i = 1) |-> 1 ]
def o : (i : I) -> (j : I) -> Partial (i \/ j) Nat := fun i => fun j => [ (i = 1) |-> 0 , (j = 1) |-> 0 ]
def s2 : Partial i1 Nat := [ i1 |-> 7 ]
def t : Path Nat (fromPartial s2) 7 := refl
def e : Partial i0 Nat := []
def c : (i : I) -> Partial (i /\ ~ i) Nat := fun i => []
def n : Nat := fromPartial s2

-- Total systems preserve neutral payloads until elimination.
def wrap : Nat -> Partial i1 Nat := fun x => [ i1 |-> x ]
def unwrap : Nat -> Nat := fun x => fromPartial (wrap x)
def wrapLaw : (x : Nat) -> Path Nat (unwrap x) x := fun x => refl
