-- The check accepts this program, but the fold over the mutual block of Rose
-- and Kids walks a tree that exists only at run time. `langc ir` must refuse
-- it with REFUSE_RUNTIME_TREE. The entry has a Nat parameter and result, so
-- the Rose value rides in the accumulator.
def bad : (n : Nat) -> Nat := fun (n : Nat) => first (fold (fun (acc : Prod Nat Rose) => pair (natAdd (first acc) 1) (fold Rose Kids (fun ks => rose ks) kidsNil (fun h t => kidsCons h t) (fun x y k => kidsSwap x y k) (fun k l p q => kidsSquash k l p q) (second acc))) (pair 0 (rose kidsNil)) n)
