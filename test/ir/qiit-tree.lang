-- The check accepts this program, but the fold walks a Circuit that exists
-- only at run time, and circSeq has two recursive fields. `langc ir` must
-- refuse it with REFUSE_RUNTIME_TREE. The entry has a Nat parameter and
-- result, so the Circuit value rides in the accumulator.
def bad : (n : Nat) -> Nat := fun (n : Nat) => first (fold (fun (acc : Prod Nat (Circuit (shape nil) (shape nil))) => pair (natAdd (first acc) 1) (fold (fun (a : Shape) => fun (b : Shape) => Circuit a b) (fun idA => circId idA) (fun seqA seqB seqC seqF seqG => circSeq seqA seqB seqC seqF seqG) (fun idlA idlB idlF => circIdl idlA idlB idlF) (fun idrA idrB idrF => circIdr idrA idrB idrF) (fun asA asB asC asD asF asG asH => circAssoc asA asB asC asD asF asG asH) (fun sqA sqB sqF sqG sqP sqQ => circSquash sqA sqB sqF sqG sqP sqQ) (second acc))) (pair 0 (circId (shape nil))) n)
